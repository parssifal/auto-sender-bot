# Copy this file to `.env` and fill values.

# Required: Telegram bot token from @BotFather
BOT_TOKEN="PUT_YOUR_TOKEN_HERE"

# Optional: legacy name (supported as alias for BOT_TOKEN)
# TG_TOKEN="PUT_YOUR_TOKEN_HERE"

# Optional: SQLite DB path (local)
DB_PATH="data/bot.db"

# Optional: Redis URL for persistent FSM storage
# REDIS_URL="redis://redis:6379/0"

# Optional: Healthcheck server bind address and port
HEALTHCHECK_HOST="127.0.0.1"
HEALTHCHECK_PORT="8080"

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL="INFO"

# Optional: Scheduler poll interval (seconds)
SCHEDULER_POLL_SECONDS="2.0"

# Optional: Telegram long-polling timeout in seconds for getUpdates
TELEGRAM_POLLING_TIMEOUT_SECONDS="30"

# Optional: Telegram HTTP request timeout in seconds
TELEGRAM_HTTP_TIMEOUT_SECONDS="75"

# --- Admin Mini App (optional) ---
# Comma-separated Telegram user IDs allowed to open /admin.
# (BOT_ADMIN_IDS is accepted as an alias.)
# ADMIN_IDS="123456789,987654321"

# Public HTTPS URL where the mini app is reachable (required to enable /admin).
# Telegram only opens Mini Apps over HTTPS with a valid certificate.
#   Prod:  put a domain + reverse proxy (e.g. Caddy, auto Let's Encrypt) in front
#          of WEBAPP_PORT and set this to that domain.
#   Dev:   run `cloudflared tunnel --url http://localhost:8081` and paste the URL.
# WEBAPP_URL="https://bot.example.com"

# Bind address/port for the mini app HTTP server (TLS is terminated by the proxy).
WEBAPP_HOST="0.0.0.0"
WEBAPP_PORT="8081"
