# Caddyfile — permanent HTTPS front for the Mini App(s)
#
# Reverse-proxies https://<sub>.duckdns.org -> the bot's aiohttp webapp on
# 127.0.0.1:8081 (plain HTTP), with automatic Let's Encrypt TLS.
#
# Install location on the VPS: /etc/caddy/Caddyfile
# Reload after edits:          sudo systemctl reload caddy
#
# Prerequisites (owner):
#   - DNS: <sub>.duckdns.org must resolve to this VPS's public IP.
#   - Firewall: inbound TCP 80 (ACME HTTP-01 challenge) and 443 (TLS) open.
#   - The bot is running and listening on 127.0.0.1:8081
#     (docker-compose already publishes 127.0.0.1:8081:8081).
#
# Replace <sub> below with your registered DuckDNS subdomain before use.

<sub>.duckdns.org {
	# Automatic HTTPS via Let's Encrypt. Set a contact email so ACME can
	# warn about exp/renewal issues (optional but recommended).
	# tls you@example.com

	encode gzip zstd

	# Security headers (defence-in-depth; static pages already escape output).
	# CSP is scoped to what the Mini App actually loads (see core/webapp_static):
	#   - script-src: self + inline scripts + Telegram's telegram-web-app.js
	#   - style-src:  self + inline <style> blocks
	#   - connect-src/img-src: same-origin /api/* (img also allows data: URIs)
	#   - base-uri 'none' and frame-ancestors restrict base tags / embedding to
	#     Telegram's webview only.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://telegram.org; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; frame-ancestors https://*.telegram.org"
		X-Content-Type-Options "nosniff"
	}

	# Caddy already forwards Host + X-Forwarded-* to the upstream by default,
	# so a plain reverse_proxy is enough.
	reverse_proxy 127.0.0.1:8081

	# Access log. NOTE: Caddy runs as the `caddy` user, so /var/log/caddy must
	# be writable by it: `sudo chown -R caddy:caddy /var/log/caddy` (see README).
	log {
		output file /var/log/caddy/miniapp-access.log
	}
}
